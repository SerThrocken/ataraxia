<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only by nature: DPAPI (ProtectedData) has no cross-platform equivalent.
         net9.0-windows: consumed by the PowerToys Run plugin.
         net10.0-windows10.0.26100.0: the WinUI3 app. -->
    <TargetFrameworks>net9.0-windows;net10.0-windows10.0.26100.0</TargetFrameworks>
    <RootNamespace>Hermes.Client.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermes.Client.Core\Hermes.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT (dotnet/runtime). Provides ProtectedData for DPAPI. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- MIT (sshnet/SSH.NET, verified at source 2026-10-12 — see DEPENDENCIES.md).
         Managed SSH-2 client: SshClient + ShellStream back ITerminalSession. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
