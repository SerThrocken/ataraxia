<ContentDialog
    x:Class="Hermes.Client.WinUI3.Views.ScheduleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    mc:Ignorable="d"
    Title="Schedule with plain language"
    PrimaryButtonText="Create job"
    CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <controls:NullToVisibilityConverter x:Key="NullToVisibility" />
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="420">
        <TextBox Header="What should run, and when?"
                 AutomationProperties.Name="Schedule description in plain language"
                 Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="brief me every morning at 7" />

        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Spacing="4"
                    Visibility="{x:Bind ViewModel.Parsed, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="I'll create this job:" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock AutomationProperties.Name="Parsed schedule summary">
                <Run Text="{x:Bind ViewModel.Parsed.Summary, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="{x:Bind ViewModel.Parsed.CronExpression, Mode=OneWay}" FontFamily="Consolas"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
            <TextBlock Text="{x:Bind ViewModel.Parsed.Prompt, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Agent prompt" />
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</ContentDialog>
