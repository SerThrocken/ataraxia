<Page
    x:Class="Hermes.Client.WinUI3.Views.ProviderHealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    xmlns:vm="using:Hermes.Client.WinUI3.ViewModels"
    mc:Ignorable="d"
    AutomationProperties.Name="Provider health">

    <Page.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Provider health" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh provider health"
                    ToolTipService.ToolTip="Reload the platform table from GET /health/detailed" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="20" Height="20"
                          AutomationProperties.Name="Loading provider health" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.Name="Provider headline" />
            <TextBlock Text="Connection state and last error per platform. Per-provider latency, error rates, and quota state are not exposed by the gateway, so they are not shown here."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Provider health error" />
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                  SelectionMode="None"
                  AutomationProperties.Name="Provider health board">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderRow">
                    <StackPanel Padding="4,10" Spacing="2"
                                AutomationProperties.Name="{x:Bind Name}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Background="{ThemeResource SystemFillColorCautionBrush}"
                                    CornerRadius="8" Padding="8,2"
                                    Visibility="{x:Bind NeedsAttention, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.AccessibilityView="Raw">
                                <TextBlock Text="needs attention"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{x:Bind State}" />
                            <Run Text=" • last update " />
                            <Run Text="{x:Bind UpdatedText}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ErrorText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind LatencyText}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
