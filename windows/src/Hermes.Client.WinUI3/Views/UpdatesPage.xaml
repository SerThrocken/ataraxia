<Page
    x:Class="Hermes.Client.WinUI3.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    mc:Ignorable="d"
    AutomationProperties.Name="Updates">

    <Page.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- This app's own self-updates (Velopack). -->
            <TextBlock Text="App updates" Style="{StaticResource SubtitleTextBlockStyle}" />

            <TextBlock AutomationProperties.Name="App version">
                <Run Text="This app: version " /><Run Text="{x:Bind ViewModel.Updates.CurrentVersion, Mode=OneWay}" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check for updates"
                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                        AutomationProperties.Name="Check for app updates"
                        ToolTipService.ToolTip="Ask the update feed for a newer version" />
                <Button Content="Download update"
                        Command="{x:Bind ViewModel.DownloadUpdateCommand}"
                        AutomationProperties.Name="Download app update"
                        ToolTipService.ToolTip="Download the newer version" />
                <Button Content="Restart to install"
                        Command="{x:Bind ViewModel.ApplyUpdateCommand}"
                        AutomationProperties.Name="Restart to install update"
                        ToolTipService.ToolTip="Apply the downloaded update and restart the app" />
            </StackPanel>

            <ProgressBar Value="{x:Bind ViewModel.Updates.Progress, Mode=OneWay}"
                         Maximum="1"
                         Visibility="{x:Bind ViewModel.Updates.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                         AutomationProperties.Name="Update download progress" />

            <TextBlock Text="{x:Bind ViewModel.Updates.Message, Mode=OneWay}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="App update status" />

            <!-- Gateway version (read-only: the gateway exposes no update APIs). -->
            <TextBlock Text="Gateway" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh gateway version"
                        ToolTipService.ToolTip="Reload GET /health/detailed from the gateway" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="20" Height="20"
                              AutomationProperties.Name="Loading gateway version" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}"
                       AutomationProperties.Name="Gateway version headline" />

            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Updates error" />

            <InfoBar Severity="Informational"
                     IsOpen="True"
                     IsClosable="False"
                     Message="{x:Bind ViewModel.GatewayNote}"
                     AutomationProperties.Name="Gateway updates notice" />
        </StackPanel>
    </ScrollViewer>
</Page>
