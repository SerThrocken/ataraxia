<Page
    x:Class="Hermes.Client.WinUI3.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBox Header="Gateway URL"
                     AutomationProperties.Name="Gateway URL"
                     Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay}" />
            <Button Content="Use loopback (this machine instead)"
                    AutomationProperties.Name="Use loopback address, this machine instead"
                    Command="{x:Bind ViewModel.UseLoopbackCommand}"
                    Style="{StaticResource TextButtonStyle}"
                    HorizontalAlignment="Left" />

            <PasswordBox Header="API key"
                         AutomationProperties.Name="API key"
                         Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.KeyStatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Stored with Windows DPAPI — never in plain text, never in settings files."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Test connection"
                        AutomationProperties.Name="Test connection"
                        Command="{x:Bind ViewModel.TestConnectionCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Content="Save"
                        AutomationProperties.Name="Save connection settings"
                        Command="{x:Bind ViewModel.SaveCommand}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.TestResult, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Quick entry" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="A system-wide hotkey that summons a quick-entry box from any app."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBox Header="Global hotkey"
                     AutomationProperties.Name="Global quick entry hotkey"
                     Text="{x:Bind ViewModel.HotkeyText, Mode=TwoWay}"
                     PlaceholderText="Ctrl+Shift+A" />
            <Button Content="Apply hotkey"
                    AutomationProperties.Name="Apply global hotkey"
                    Command="{x:Bind ViewModel.ApplyHotkeyCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />

            <TextBlock Text="Import" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Copy a saved connection and desktop settings from the Hermes desktop app (Electron). API keys go straight into encrypted Windows storage."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <Button Content="Import from Hermes Desktop…"
                    AutomationProperties.Name="Import from Hermes Desktop"
                    Click="ImportButton_Click"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
