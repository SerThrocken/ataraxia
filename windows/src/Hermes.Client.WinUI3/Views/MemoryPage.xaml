<Page
    x:Class="Hermes.Client.WinUI3.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
        <TextBlock Text="Memory" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Notice}"
                 AutomationProperties.Name="Memory notice" />

        <TextBlock Text="{x:Bind ViewModel.Detail}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</Page>
