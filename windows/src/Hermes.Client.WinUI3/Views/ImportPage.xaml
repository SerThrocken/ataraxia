<Page
    x:Class="Hermes.Client.WinUI3.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Hermes.Client.WinUI3.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Import from Hermes Desktop"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Reads the Electron app's saved connections and settings, and copies what you choose into this app. API keys go straight into encrypted Windows storage — never plain text, never shown here."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                          Width="32" Height="32"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Scanning" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />

            <TextBlock Text="Connections"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="{x:Bind ViewModel.HasConnections, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.HasConnections, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ImportableConnection">
                        <RadioButton GroupName="ImportConnections"
                                     IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                     AutomationProperties.Name="{x:Bind DisplayName}"
                                     Margin="0,0,0,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detail}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind KeyDetail}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox Content="Import desktop settings"
                      AutomationProperties.Name="Import desktop settings"
                      IsChecked="{x:Bind ViewModel.ImportSettings, Mode=TwoWay}"
                      Visibility="{x:Bind ViewModel.HasSettings, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SettingsSummary, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Import"
                        AutomationProperties.Name="Import selected items"
                        Command="{x:Bind ViewModel.ImportCommand}"
                        IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Back"
                        AutomationProperties.Name="Back"
                        Click="BackButton_Click" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Result, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Imported. Use Back to return and test the connection."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind ViewModel.ImportSucceeded, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
