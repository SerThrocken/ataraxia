<Page
    x:Class="Hermes.Client.WinUI3.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Hermes.Client.WinUI3.ViewModels"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    mc:Ignorable="d"
    AutomationProperties.Name="Chat">

    <Page.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="UserTemplate" x:DataType="vm:UserMessageItem">
            <Border HorizontalAlignment="Right" MaxWidth="720"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="48,4,0,4"
                    AutomationProperties.Name="{x:Bind Text}">
                <StackPanel Spacing="6">
                    <Image Source="{x:Bind Image, Mode=OneWay}"
                           Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           Stretch="Uniform" MaxHeight="220"
                           AutomationProperties.Name="Attached photo" />
                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate" x:DataType="vm:AssistantMessageItem">
            <StackPanel Spacing="6" Margin="0,4,48,4"
                        AutomationProperties.Name="Assistant message">
                <Expander Header="Reasoning"
                          Visibility="{x:Bind HasReasoning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Reasoning">
                    <TextBlock Text="{x:Bind Reasoning, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Expander>
                <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                           Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="Tool status" />
                <TextBlock Text="{x:Bind Commentary, Mode=OneWay}"
                           Visibility="{x:Bind HasCommentary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.Name="Assistant commentary" />
                <controls:MarkdownBlock Markdown="{x:Bind Text, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ApprovalTemplate" x:DataType="vm:ApprovalItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,48,4"
                    AutomationProperties.Name="{x:Bind CardName, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Approval requested" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind Request.Command, Mode=OneWay}"
                               FontFamily="Consolas" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               AutomationProperties.Name="Command awaiting approval" />
                    <TextBlock Text="{x:Bind Request.Description, Mode=OneWay}"
                               Visibility="{x:Bind Request.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ButtonsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Allow once"
                                Command="{x:Bind ResolveCommand}" CommandParameter="once"
                                Visibility="{x:Bind OfferOnce, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Allow once" />
                        <Button Content="Always allow"
                                Command="{x:Bind ResolveCommand}" CommandParameter="always"
                                Visibility="{x:Bind OfferAlways, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Always allow" />
                        <Button Content="Deny"
                                Command="{x:Bind ResolveCommand}" CommandParameter="deny"
                                Visibility="{x:Bind OfferDeny, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Deny" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}"
                               Visibility="{x:Bind IsResolved, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="Approval resolution" />
                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Approval error" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolTemplate" x:DataType="vm:ToolMessageItem">
            <TextBlock Text="{x:Bind Text, Mode=OneWay}" Margin="0,2,48,2"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Tool message" />
        </DataTemplate>

        <DataTemplate x:Key="QueuedTemplate" x:DataType="vm:QueuedMessageItem">
            <Border HorizontalAlignment="Right" MaxWidth="720"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="48,4,0,4"
                    AutomationProperties.Name="{x:Bind Text, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="Photo attached"
                               Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.Name="Photo attached to queued message" />
                    <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.Name="Queue status" />
                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                               Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Queue error" />
                    <Button Content="Retry sending"
                            Command="{x:Bind RetryCommand}"
                            Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Retry sending queued message" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DiffTemplate" x:DataType="vm:DiffItem">
            <Border HorizontalAlignment="Stretch" MaxWidth="720"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,48,4"
                    AutomationProperties.Name="{x:Bind Summary, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <controls:DiffViewer DiffSource="{x:Bind DiffSource, Mode=OneWay}"
                                             ToolCallId="{x:Bind ToolCallId, Mode=OneWay}" />
                    </ScrollViewer>
                    <Button Content="Review changes…" Click="OnReviewDiffClick"
                            AutomationProperties.Name="Review file changes hunk by hunk" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <controls:TranscriptTemplateSelector x:Key="TranscriptSelector"
                                             UserTemplate="{StaticResource UserTemplate}"
                                             AssistantTemplate="{StaticResource AssistantTemplate}"
                                             ApprovalTemplate="{StaticResource ApprovalTemplate}"
                                             ToolTemplate="{StaticResource ToolTemplate}"
                                             DiffTemplate="{StaticResource DiffTemplate}"
                                             QueuedTemplate="{StaticResource QueuedTemplate}" />
    </Page.Resources>

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main column -->
        <Grid Grid.Column="0" RowSpacing="8" Padding="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SessionTitle, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Session title" />

            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Chat error" />

            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Transcript, Mode=OneWay}"
                      ItemTemplateSelector="{StaticResource TranscriptSelector}"
                      SelectionMode="None"
                      AutomationProperties.Name="Chat transcript">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <InfoBar Grid.Row="3"
                     IsOpen="{x:Bind ViewModel.HasQueued, Mode=OneWay}"
                     Severity="Informational"
                     Title="{x:Bind ViewModel.QueueStatusText, Mode=OneWay}"
                     Message="Messages are stored on this device and send automatically when the gateway reconnects."
                     IsClosable="False"
                     AutomationProperties.Name="{x:Bind ViewModel.QueueStatusText, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind ViewModel.HasPendingPhoto, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Photo to send">
                <Image Source="{x:Bind ViewModel.PendingPhotoImage, Mode=OneWay}"
                       Width="96" Height="72" Stretch="UniformToFill"
                       AutomationProperties.Name="Photo preview" />
                <Button Content="Remove photo"
                        Command="{x:Bind ViewModel.RemovePhotoCommand}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Remove attached photo" />
            </StackPanel>

            <Grid Grid.Row="5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="MessageInput"
                         Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Type a message…"
                         AutomationProperties.Name="Message input"
                         KeyDown="MessageInput_KeyDown" />
                <Button Grid.Column="1" Content="&#xE714;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.CapturePhotoCommand}"
                        AutomationProperties.Name="Take a photo with the camera"
                        ToolTipService.ToolTip="Attach a camera photo" />
                <Button Grid.Column="2" Content="Send"
                        Command="{x:Bind ViewModel.SendCommand}"
                        AutomationProperties.Name="Send message"
                        ToolTipService.ToolTip="Send (Enter)" />
            </Grid>
        </Grid>

        <!-- Artifact side panel -->
        <Border Grid.Column="1" Width="340"
                Visibility="{x:Bind ViewModel.ArtifactPaneVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0" Padding="12"
                AutomationProperties.Name="Artifacts panel">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Artifacts"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Artifacts, Mode=OneWay}"
                          SelectionMode="None"
                          AutomationProperties.Name="Artifact list">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArtifactItem">
                            <StackPanel Spacing="4" Padding="0,6"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                <Image Source="{x:Bind Image, Mode=OneWay}"
                                       Visibility="{x:Bind IsImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                       Stretch="Uniform" MaxHeight="220"
                                       AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" />
                                <ScrollViewer MaxHeight="320"
                                              Visibility="{x:Bind IsText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Bind TextPreview, Mode=OneWay}"
                                               FontFamily="Consolas" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Meta, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
