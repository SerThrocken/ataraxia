<Page
    x:Class="Hermes.Client.WinUI3.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:Hermes.Client.Core"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12" MaxWidth="920" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Search" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="QueryBox"
                     Width="420"
                     PlaceholderText="Search sessions…"
                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="QueryBox_KeyDown"
                     AutomationProperties.Name="Search query" />
            <Button Content="Search"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    AutomationProperties.Name="Run search" />
            <Button Content="Cancel"
                    Command="{x:Bind ViewModel.CancelSearchCommand}"
                    Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="Cancel search" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                          Width="20" Height="20"
                          AutomationProperties.Name="Searching" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Search status" />

        <ListView Grid.Row="3"
                  x:Name="ResultsList"
                  ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                  SelectionMode="Single"
                  KeyDown="ResultsList_KeyDown"
                  AutomationProperties.Name="Search results">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:SearchHit">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind SessionTitle}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Role}" /><Run Text=" match" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind Snippet}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4"
                   Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Search error" />
    </Grid>
</Page>
