<Page
    x:Class="Hermes.Client.WinUI3.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="12" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Connect to Hermes" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Point the app at your Hermes gateway. Tailscale first — the loopback address works when you're on the Acer itself."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <TextBox Header="Gateway URL"
                     AutomationProperties.Name="Gateway URL"
                     Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay}" />
            <Button Content="Use loopback (this machine instead)"
                    AutomationProperties.Name="Use loopback address, this machine instead"
                    Command="{x:Bind ViewModel.UseLoopbackCommand}"
                    Style="{StaticResource TextButtonStyle}"
                    HorizontalAlignment="Left" />

            <PasswordBox Header="API key"
                         AutomationProperties.Name="API key"
                         Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.KeyStatusText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Stored with Windows DPAPI — never in plain text."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Content="Test connection"
                    AutomationProperties.Name="Test connection"
                    Command="{x:Bind ViewModel.TestConnectionCommand}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
            <TextBlock Text="{x:Bind ViewModel.TestResult, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.CapabilitySummary, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <Button Content="Save &amp; continue"
                    AutomationProperties.Name="Save and continue"
                    Command="{x:Bind ViewModel.SaveAndContinueCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Assertive"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Already use the Hermes desktop app? Import its connection instead of typing the URL and key."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <Button Content="Import from Hermes Desktop"
                    AutomationProperties.Name="Import from Hermes Desktop"
                    Click="ImportButton_Click"
                    Style="{StaticResource TextButtonStyle}"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
