<Page
    x:Class="Hermes.Client.WinUI3.Views.TerminalBackendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
        <TextBlock Text="Terminal" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Notice}"
                 AutomationProperties.Name="Terminal notice" />

        <TextBlock Text="Preferred local terminal"
                   Style="{StaticResource SubtitleTextBlockStyle}" />
        <ComboBox ItemsSource="{x:Bind ViewModel.TerminalOptions}"
                  SelectedItem="{x:Bind ViewModel.PreferredTerminal, Mode=TwoWay}"
                  Width="280"
                  AutomationProperties.Name="Preferred local terminal" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="Saved automatically. Used when local terminal integration lands." />
    </StackPanel>
</Page>
