<UserControl
    x:Class="Hermes.Client.WinUI3.Controls.DiffViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:Hermes.Client.Core"
    xmlns:controls="using:Hermes.Client.WinUI3.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <controls:DiffLineKindToBrushConverter x:Key="DiffKindToBrush" />
        <controls:DiffLineKindToSignConverter x:Key="DiffLineKindToSign" />

        <DataTemplate x:Key="DiffLineTemplate" x:DataType="core:DiffLine">
            <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                       Foreground="{x:Bind Kind, Converter={StaticResource DiffKindToBrush}}"
                       AutomationProperties.Name="{x:Bind Text}">
                <Run Text="{x:Bind Kind, Converter={StaticResource DiffLineKindToSign}}" /><Run Text="{x:Bind Text}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <TextBlock x:Name="EmptyText"
                   Text="No diff available for this change."
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"
                   AutomationProperties.Name="No diff available" />

        <!-- Read-only rendering (transcript). -->
        <ItemsControl x:Name="FilesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:DiffFile">
                    <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="{x:Bind NewPath}" FontFamily="Consolas"
                                       AutomationProperties.Name="{x:Bind NewPath}" />
                        </Expander.Header>
                        <ItemsControl ItemsSource="{x:Bind Hunks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:DiffHunk">
                                    <StackPanel Spacing="0" Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind Header}" FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   AutomationProperties.Name="{x:Bind Header}" />
                                        <ItemsControl ItemsSource="{x:Bind Lines}"
                                                      ItemTemplate="{StaticResource DiffLineTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Review mode: per-hunk accept/reject + patch export. -->
        <StackPanel x:Name="ReviewPanel" Spacing="8" Visibility="Collapsed">
            <ItemsControl x:Name="ReviewFilesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:HunkReviewFile">
                        <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                            <Expander.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayPath}"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               AutomationProperties.Name="{x:Bind DisplayPath}" />
                                    <Button Grid.Column="1" Content="Accept all"
                                            Command="{x:Bind AcceptAllCommand}"
                                            AutomationProperties.Name="{x:Bind AcceptAllName}" />
                                    <Button Grid.Column="2" Content="Reject all"
                                            Command="{x:Bind RejectAllCommand}"
                                            AutomationProperties.Name="{x:Bind RejectAllName}" />
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{x:Bind Hunks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:HunkRow">
                                        <StackPanel Spacing="4" Margin="0,0,0,12">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Hunk.Header}"
                                                           FontFamily="Consolas" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           AutomationProperties.Name="{x:Bind Hunk.Header}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind StateText, Mode=OneWay}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           AutomationProperties.Name="{x:Bind StateName, Mode=OneWay}" />
                                                <Button Grid.Column="2" Content="Accept"
                                                        Command="{x:Bind AcceptCommand}"
                                                        AutomationProperties.Name="{x:Bind AcceptName}" />
                                                <Button Grid.Column="3" Content="Reject"
                                                        Command="{x:Bind RejectCommand}"
                                                        AutomationProperties.Name="{x:Bind RejectName}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind Hunk.Lines}"
                                                          ItemTemplate="{StaticResource DiffLineTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ReviewCounts"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.Name="Review counts" />

            <Button x:Name="ExportButton" Content="Export accepted hunks (.patch)"
                    Click="OnExportClick" IsEnabled="False"
                    AutomationProperties.Name="Export accepted hunks as a patch file" />

            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.Name="Why export only">
                <Run Text="The gateway (0.21.6) has no file-apply route, so nothing here writes to the agent's files. " /><Run Text="Accept/reject records your review — export the accepted hunks as a .patch and apply it yourself." />
            </TextBlock>
        </StackPanel>
    </StackPanel>
</UserControl>
