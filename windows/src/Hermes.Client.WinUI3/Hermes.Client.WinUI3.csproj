<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Hermes.Client.WinUI3</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: no MSIX, runs as a plain exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\ataraxia.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- MIT, verified at source 2026-10-11 (github.com/codebude/QRCoder README + nuget.org). See DEPENDENCIES.md. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermes.Client.Core\Hermes.Client.Core.csproj" />
    <ProjectReference Include="..\Hermes.Client.Infrastructure\Hermes.Client.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied to output so AppWindow.SetIcon can load it at runtime (unpackaged). -->
    <Content Include="Assets\ataraxia.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The app icon binary cannot be pushed through the text-only file API, so the
    repo carries Assets/ataraxia.ico.b64 (base64 text) and this target decodes it
    to Assets/ataraxia.ico before the build needs it. Incremental: skipped when
    the .ico is newer than the .b64. The generated .ico is git-ignored.
  -->
  <Target Name="DecodeAppIcon" BeforeTargets="PrepareForBuild"
          Inputs="$(ProjectDir)Assets\ataraxia.ico.b64"
          Outputs="$(ProjectDir)Assets\ataraxia.ico">
    <Exec Command="powershell -NoProfile -Command &quot;[IO.File]::WriteAllBytes('$(ProjectDir)Assets\ataraxia.ico', [Convert]::FromBase64String([IO.File]::ReadAllText('$(ProjectDir)Assets\ataraxia.ico.b64')))&quot;" />
  </Target>

</Project>
